    }
  },
  {
    "id": "elem_17",
    "type": "body",
    "content": "主要文献：LoRA-Drop: Efficient LoRA Parameters Dropping for Large Language Models，arXiv:2601.02569v1",
    "style": {
      "style_name": "Normal",
      "alignment": "left"
    }
  },
  {
    "id": "elem_18",
    "type": "body",
    "content": "相关文献：",
    "style": {
