{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "docx_cli: page-number",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/docx_manager/docx_engine/engine/docx_cli.py",
            "console": "integratedTerminal",
            "args": [
                "page-number",
                "${workspaceFolder}/docx_manager/docx_engine/outputs/output.docx",
                "--from-config",
                "docx_manager\\docx_engine\\sections_config\\hit_config.json",
            ],
            "justMyCode": true
        },
        {
            "name": "docx_cli: insert-image (after-para)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/docx_manager/docx_engine/engine/docx_cli.py",
            "console": "integratedTerminal",
            "args": [
                "insert-image",
                "after-para",
                "${workspaceFolder}/docx_manager/docx_engine/outputs/output.docx",
                "5",
                "img.png",
                "200",
                "150",
                "--caption", "图1",
                "--app", "wps",
                "--visible"
            ],
            "justMyCode": true
        },
        {
            "name": "docx_cli: insert-image (within-section)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/docx_manager/docx_engine/engine/docx_cli.py",
            "console": "integratedTerminal",
            "args": [
                "insert-image",
                "within-section",
                "${workspaceFolder}/docx_manager/docx_engine/outputs/output.docx",
                "3",
                "img.png",
                "200",
                "150",
                "--anchor", "auto",
                "--app", "wps",
                "--visible"
            ],
            "justMyCode": true
        }
    ]
}