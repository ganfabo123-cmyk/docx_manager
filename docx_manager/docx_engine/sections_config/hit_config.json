{
  "template": "hit-template",
  "description": "哈工大学位论文模板节配置。第一节固定为摘要，每个一级标题对应一节；摘要/Abstract/目录用罗马数字，目录后正文用阿拉伯数字从1开始。",
  "page_size": {"w": "11906", "h": "16838"},
  "dismiss_before_front": true,
  "toc_max_level": 4,
  "page_break_before_body_h1": true,
  "detect_reference_pattern": true,
  "reference_pattern": "［\\d+］",

  "cover_section_break": {
    "note": "封面节，含首页不同页眉(first)，无页码",
    "header_refs": {"first": "rId5", "default": "rId3", "even": "rId4"},
    "footer_refs": {"default": "rId6", "even": "rId7"},
    "page_size": {"w": "11906", "h": "16838"}
  },

  "special_section_break": [
    {
      "name":             "摘  要",
      "note":             "中文摘要及英文摘要节共享此分节配置（英文摘要继承）",
      "header_refs":      {},
      "footer_refs":      {"default": "rId8", "even": "rId9"},
      "page_size":        {"w": "11906", "h": "16838"},
      "restart_page_number": 1,
      "addition_attrs":{
              "en_abstract_name": "Abstract"
      }
    },
    {
      "name":                    "目  录",
      "note":                    "目录节；auto_generate_toc 触发目录生成；后续所有正文节继承此配置",
      "header_refs":             {"default": "rId14", "even": "rId15"},
      "footer_refs":             {"default": "rId16"},
      "page_size":               {"w": "11906", "h": "16838"},
      "restart_page_number": 1,
      "addition_attrs":{
              "auto_generate_toc":       true
      }
    }
  ],

  "hit_footer_rule": {
    "note": "一次性全文页码方案：先清空全文页脚，再按规则依次应用",
    "rules": [
      {"sec_from": 1, "sec_to": 3, "style": "roman-upper", "position": "bottom-center", "start_idx": 1},
      {"sec_from": 4, "sec_to": 0,  "style": "dash-arabic", "position": "bottom-center", "start_idx": 1}
    ]
  },

  "figure_defaults": {
    "note": "insert_figure 的默认尺寸，当 user_data 中未提供 width/height 时使用",
    "width_pt": 198.43,
    "height_pt": 99.21
  }
}
